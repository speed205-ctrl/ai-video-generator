# ==============================================================
# Configuración de AI Video Automation Suite (.env.example)
# Copia este archivo como '.env' y completa tus credenciales.
# ==============================================================

# 1. Inteligencia Artificial (Redacción de Guiones y LLM)
# Opción A: NVIDIA Cloud (Recomendado gratuito)
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Opción B: OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta/llama-3.3-70b-instruct

# Opción C: Ollama Local (100% Gratuito y sin API Keys)
# USE_OLLAMA=true

# 2. Síntesis de Voz Neural (ElevenLabs)
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=N2lVS1w4EtoT3dr4eOWO

# 3. Generación de Imágenes (NVIDIA Cloud Flux)
NVIDIA_IMAGE_KEY=nvapi-...
NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-schnell
NVIDIA_IMAGE_MODEL=flux.1-schnell

# 4. Generación de Imágenes Alternativa (Hugging Face)
HUGGINGFACE_API_KEY=hf_...
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# 5. CapCut Desktop (Opcional, se auto-detecta en C: o D:)
# CAPCUT_DRAFT_PATH=C:/CapCut Projects/com.lveditor.draft
